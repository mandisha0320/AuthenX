# ─────────────────────────────────────────────────────────────
#  AuthenX — .env.example
#  Copy this to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_DEBUG=false
PORT=5000
SECRET_KEY=change-me-in-production-use-a-long-random-string

# MongoDB (default: local instance)
MONGO_URI=mongodb://localhost:27017/authenx

# File upload limits
MAX_UPLOAD_MB=500

# Search backend: "duckduckgo" (free, default) or "serpapi"
SEARCH_BACKEND=duckduckgo

# SerpAPI (only required if SEARCH_BACKEND=serpapi)
SERPAPI_KEY=your_serpapi_key_here

# Model paths (optional — uses ImageNet weights if not found)
IMAGE_MODEL_CHECKPOINT=checkpoints/image_deepfake.pth

# Embedding model (sentence-transformers model name or local path)
EMBED_MODEL=all-MiniLM-L6-v2

# Video processing
VIDEO_BATCH_SIZE=8
VIDEO_MAX_FRAMES=120
